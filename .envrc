# SPDX-License-Identifier: MPL-2.0
# Activate development environment
# Install direnv: https://direnv.net/

# Load the pinned toolchain (mise)
if has mise; then
  use mise
fi

# Load the Guix shell if Guix is available (guix.scm manifest)
if has guix && [ -f guix.scm ]; then
  use guix
fi

# Project environment variables (non-secret only — real secrets belong in
# .env, which is gitignored, never in .envrc)
export PROJECT_NAME="aerie"
export RSR_TIER="component"

# Gateway ports (defaults; override in .env for local experimentation)
export AERIE_HTTP_PORT=4000
export AERIE_GRPC_PORT=4001

# Source .env if it exists (gitignored)
dotenv_if_exists
