//
// Dev Container configuration for aerie
// Works with: VS Code Dev Containers, GitHub Codespaces, Gitpod
// Container runtime: Podman (recommended) or any OCI-compliant runtime
{
  "name": "aerie",

  "build": {
    "dockerfile": "Containerfile",
    "context": ".."
  },

  "postCreateCommand": "just doctor || true",

  "remoteUser": "nonroot",

  "containerEnv": {
    "EDITOR": "code --wait",
    "LANG": "C.UTF-8",
    "AERIE_HTTP_PORT": "4000",
    "AERIE_GRPC_PORT": "4001"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "EditorConfig.EditorConfig",
        "eamodio.gitlens",
        "streetsidesoftware.code-spell-checker",
        "timonwong.shellcheck",
        "tamasfe.even-better-toml",
        "skellock.just",
        "redhat.vscode-yaml",
        "DavidAnson.vscode-markdownlint",
        "asciidoctor.asciidoctor-vscode",
        "usernamehw.errorlens"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true,
        "files.trimFinalNewlines": true
      }
    }
  },

  "forwardPorts": [4000, 4001],

  "shutdownAction": "stopContainer"
}
